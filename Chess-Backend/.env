# Environment variables for Chess Backend API

# OpenAI API Key for chess AI responses
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key for text-to-speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Database connection (for local development)
# Use this format for local PostgreSQL:
# DATABASE_URL=postgres://username:password@localhost:5432/chessdb

# For Render deployment, Render will automatically provide DATABASE_URL
# PORT=5000  # This will be automatically set by Render